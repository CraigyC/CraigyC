# Copy to .env and fill in.

# ---------- access ----------
ADMIN_PASSWORD=change-me
# Optional: guests must enter this to join (leave empty for no PIN)
PARTY_PIN=
# Optional: a fixed session secret. If empty one is generated and stored in the database.
SECRET_KEY=

# ---------- library ----------
# Where the WiiM (or Home Assistant) can reach THIS server. Must be the LAN address, not localhost.
PUBLIC_BASE_URL=http://192.168.1.50:8000
# Only used when running without Docker (Docker mounts your music at /music)
# MUSIC_DIR=/path/to/music

# ---------- speaker for local files ----------
# wiim          -> talk to the WiiM directly (simplest, no Home Assistant needed)
# homeassistant -> use a Home Assistant media_player entity (e.g. the WiiM/LinkPlay integration)
# dummy         -> no speaker, just simulate playback (for trying it out)
PLAYER=wiim
WIIM_HOST=192.168.1.60

# HA_URL=http://homeassistant.local:8123
# HA_TOKEN=long-lived-access-token
# HA_ENTITY_ID=media_player.wiim_pro

# ---------- Spotify (optional, needs Spotify Premium) ----------
# Create an app at https://developer.spotify.com/dashboard and add the redirect URI below to it.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/spotify/callback
# Name of the WiiM as it appears in Spotify's device list (host page -> "Show Spotify devices")
SPOTIFY_DEVICE_NAME=WiiM Pro

# ---------- fairness tuning ----------
# importance of a user's n-th track = 1 / (1 + IMPORTANCE_DECAY * (n-1))   (0 = everyone always equal)
IMPORTANCE_DECAY=1.0
# chance a user's k-th "play next" request wins = 1 / (1 + PLAY_NEXT_DECAY * (k-1))
PLAY_NEXT_DECAY=1.0
